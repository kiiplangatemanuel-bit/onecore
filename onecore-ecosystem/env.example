# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
DEBUG=false
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=sqlite:///./onecore.db
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
FORCE_HTTPS=false
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Optional one-time bootstrap. Set both together, then remove after first boot.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
