APP_NAME=OneCore Technologies Ltd
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=sqlite:///./data/onecore.db
# Optional Docker Compose override for an external PostgreSQL deployment.
ONECORE_DATABASE_URL=
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
BOOTSTRAP_ADMIN_EMAIL=admin@onecore.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeThis-Immediately-123!

# Provider integrations are OFF until deliberately configured.
INTEGRATION_MPESA_ENABLED=false
MPESA_BASE_URL=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://your-public-host/api/v1/integrations/mpesa/callbacks
# B2C requires approved initiator and Safaricom-encrypted security credential.
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=https://your-public-host/api/v1/integrations/mpesa/callbacks/b2c/result
MPESA_B2C_TIMEOUT_URL=https://your-public-host/api/v1/integrations/mpesa/callbacks/b2c/timeout

INTEGRATION_ETIMS_ENABLED=false
ETIMS_BASE_URL=
ETIMS_CLIENT_ID=
ETIMS_CLIENT_SECRET=
ETIMS_DEVICE_SERIAL=

INTEGRATION_SHA_ENABLED=false
SHA_BASE_URL=
SHA_CLIENT_ID=
SHA_CLIENT_SECRET=
SHA_FACILITY_CODE=

INTEGRATION_BANK_ENABLED=false
BANK_BASE_URL=
BANK_CLIENT_ID=
BANK_CLIENT_SECRET=

INTEGRATION_EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

INTEGRATION_SMS_ENABLED=false
SMS_BASE_URL=
SMS_API_KEY=
SMS_SENDER_ID=

INTEGRATION_WHATSAPP_ENABLED=false
WHATSAPP_BASE_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

INTEGRATION_AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

INTEGRATION_OBJECT_STORAGE_ENABLED=false
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=

# CRM campaign communications
CRM_PUBLIC_BASE_URL=
CRM_DELIVERY_CALLBACK_SECRET=

# Healthcare patient profiles and clinical notes require a dedicated Fernet key.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do not commit the generated key; store it in your deployment secret manager.
HEALTHCARE_PHI_ENCRYPTION_KEY=

# Optional OneCore AI fallback provider (OpenAI-compatible)
INTEGRATION_AI_FALLBACK_ENABLED=false
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
