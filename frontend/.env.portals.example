VITE_APP_URL=https://app.onecore.co.ke
VITE_ADMIN_URL=https://admin.onecore.co.ke
VITE_DEVELOPER_URL=https://developers.onecore.co.ke
VITE_DOCS_URL=https://docs.onecore.co.ke
VITE_SUPPORT_URL=https://support.onecore.co.ke
VITE_STATUS_URL=https://status.onecore.co.ke
VITE_COMMUNITY_URL=https://community.onecore.co.ke
VITE_TRUST_URL=https://trust.onecore.co.ke
VITE_EVENTS_URL=https://events.onecore.co.ke
VITE_CAREERS_URL=https://careers.onecore.co.ke
VITE_PARTNERS_URL=https://partners.onecore.co.ke
