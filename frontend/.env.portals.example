# Public frontend configuration only. VITE_* values are bundled into browser code.
# Set the actual deployed HTTPS origins in each Vercel project's Environment Variables.
VITE_API_BASE_URL=https://your-api.example.com
VITE_PUBLIC_SITE_URL=https://www.onecore.co.ke
VITE_APP_URL=https://app.onecore.co.ke
VITE_DEVELOPER_URL=https://developers.onecore.co.ke
VITE_DOCS_URL=https://docs.onecore.co.ke
VITE_CAREERS_URL=https://careers.onecore.co.ke
VITE_PARTNERS_URL=https://partners.onecore.co.ke
# Optional contact mailbox used only by the legacy public enquiry form.
VITE_PUBLIC_CONTACT_EMAIL=

# Configure the same exact portal origins in the backend PORTAL_REDIRECT_ORIGINS setting.
# This allowlist is enforced by the API; do not use wildcards.
