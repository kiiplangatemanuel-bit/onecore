# Public browser configuration for the four independent OneCore portals.
VITE_API_BASE_URL=https://api.example.com
VITE_PUBLIC_SITE_URL=https://onecore.example.com
# Set only if the authenticated customer workspace is hosted at a separate origin.
VITE_APP_URL=
VITE_DEVELOPER_URL=https://developers.example.com
VITE_DOCS_URL=https://docs.example.com
VITE_CAREERS_URL=https://careers.example.com
VITE_PARTNERS_URL=https://partners.example.com

# Optional Supabase Auth public client configuration (never use a service-role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
